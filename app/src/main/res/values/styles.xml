<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Ecommerce.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nunito_sans_semibold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Ecommerce.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_medium</item>
        <item name="boxBackgroundColor">@color/surface_gray</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="errorTextColor">@color/error_red</item>
    </style>

    <style name="Widget.Ecommerce.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/nunito_sans_semibold</item>
    </style>

    <style name="Widget.Ecommerce.SectionTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Ecommerce.ViewAll" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">@font/nunito_sans_semibold</item>
        <item name="android:padding">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.Ecommerce.Option" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/nunito_sans_semibold</item>
        <item name="buttonTint">@android:color/transparent</item>
    </style>

    <style name="Widget.Ecommerce.StepperIcon" parent="">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">6dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/white</item>
    </style>

    <style name="Widget.Ecommerce.OtpBox" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:digits">0123456789</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:cursorVisible">true</item>
    </style>

    <style name="Widget.Ecommerce.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/nunito_sans</item>
        <item name="fontFamily">@font/nunito_sans</item>
    </style>

    <style name="Widget.Ecommerce.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/nunito_sans</item>
        <item name="fontFamily">@font/nunito_sans</item>
    </style>

    <style name="Widget.Ecommerce.MaterialButton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/nunito_sans_bold</item>
        <item name="fontFamily">@font/nunito_sans_bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
