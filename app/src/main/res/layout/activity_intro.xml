<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/iconmain"
        android:layout_width="100dp"
        android:layout_height="90dp"
        android:background="@drawable/background_main"
        android:src="@drawable/splashicon"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clickable="true"/>

    <TextView
        android:id="@+id/tvintro1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iconmain"
        android:fontFamily="@font/nunito_sans_black"
        android:layout_marginTop="30dp"
        android:text="Welcome"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvintro2"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tvintro1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fontFamily="@font/nunito_sans_normal"
        android:layout_marginTop="30dp"
        android:text="light"
        android:paddingLeft="10dp"
        android:textColor="#AB7E7373"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/introshopnow"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvintro2"
        android:layout_marginTop="20dp"
        android:text="Shopnow"
        android:background="@drawable/rounded_button_background"/>

    <ImageView
        android:id="@+id/imageintro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/introshopnow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/items"
        android:layout_marginTop="400dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>