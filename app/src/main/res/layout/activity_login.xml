<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/backarrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/backarrow"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="10dp"
        android:clickable="true"/>


    <ImageView
        android:id="@+id/iconmain"
        android:layout_width="100dp"
        android:layout_height="90dp"
        android:background="@drawable/background_main"
        android:src="@drawable/splashicon"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="90dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clickable="true"/>


    <TextView
        android:id="@+id/tvloginmobile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mobile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iconmain"
        android:layout_marginTop="30dp"
        android:textStyle="bold"
        android:textSize="25sp"
        android:fontFamily="@font/nunito_sans_black"/>

    <TextView
        android:id="@+id/tvloginverification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We will send verification code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvloginmobile"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/nunito_sans_normal"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etmobile"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:inputType="phone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:hint="+91"
        android:paddingLeft="5dp"
        android:gravity="center"
        android:textColorHint="#575454"
        app:layout_constraintTop_toBottomOf="@+id/tvloginverification"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_edittext_background" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnlogin"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Continue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etmobile"
        android:layout_marginTop="50dp"
        android:textColor="#f5f5f5"
        android:background="@drawable/rounded_button_background" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvterms"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnlogin"
        android:layout_marginTop="30dp"
        android:visibility="visible"
        android:textColor="#494444"/>


</androidx.constraintlayout.widget.ConstraintLayout>